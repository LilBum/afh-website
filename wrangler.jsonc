{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afh-website",
  "main": "./worker/index.ts",
  "keep_vars": true,
  "compatibility_date": "2026-08-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
